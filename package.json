{
  "name": "cold-and-dark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D cockpit trainer for learning aircraft engine start procedures",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/klahr/cold-and-dark.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:proxy": "vite --mode proxy",
    "dev:proxy:tls": "vite --mode proxy-tls",
    "dev:tls": "vite --mode lan-tls",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
